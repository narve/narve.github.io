---
layout: layouts/base.njk
---
<article class="post">
  <header>
    <h1>{{ title }}</h1>
    <p class="meta">
      <time datetime="{{ page.date | htmlDateString }}">{{ page.date | readableDate }}</time>
      {% set realTags = tags | filterTagList %}
      {% if realTags | length %}
        ·
        {% for tag in realTags %}
          <a href="/tags/{{ tag | slugify }}/">#{{ tag }}</a>{% if not loop.last %} {% endif %}
        {% endfor %}
      {% endif %}
    </p>
    {% if isFuture %}
      <p class="scheduled-notice" role="note">
        <strong>Scheduled post.</strong> This post is dated in the future and is hidden from the home page, tag pages, feed, sitemap, and search. The URL itself works so you can share a preview link.
      </p>
    {% endif %}
  </header>
  {# Omit data-pagefind-body on scheduled posts so they're not indexed by search. #}
  <div{% if not isFuture %} data-pagefind-body{% endif %}>
    {{ content | safe }}
  </div>
</article>
<p><a href="/">← all posts</a></p>
